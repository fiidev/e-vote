generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ORG_ADMIN
}

enum OrgType {
  MAIN_ORGANIZATION
  SUB_ORGANIZATION
}

enum Role {
  SISWA
  GUKAR
  UMUM
}

model AdminUser {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  emailVerified  Boolean       @default(false)
  image          String?
  role           AdminRole     @default(ORG_ADMIN)
  organizationId String?
  termStart      DateTime?
  termEnd        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  adminsessions  AdminSession[]
  adminaccounts  AdminAccount[]

  @@map("admin_user")
}

model AdminSession {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  adminuser AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_session")
}

model AdminAccount {
  id                    String    @id @default(uuid())
  userId                String
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  adminuser             AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@map("admin_account")
}

model Organization {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  code        String         @unique
  type        OrgType        @default(SUB_ORGANIZATION)
  parentId    String?
  logoUrl     String?
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  parent      Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Organization[] @relation("OrgHierarchy")
  admins      AdminUser[]
  elections   Election[]

  @@map("organizations")
}

model Election {
  election_id    String        @id @default(uuid())
  organizationId String
  title          String
  description    String?       @db.Text
  start_time     DateTime
  end_time       DateTime
  is_active      Boolean       @default(true)
  eligible_roles Role[]        @default([SISWA])
  is_weighted    Boolean       @default(false)
  role_weights   Json?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  candidates     Candidate[]
  voters         Voter[]
  tokens         VoteToken[]
  votes          Vote[]

  @@index([organizationId])
  @@map("elections")
}

model Voter {
  voter_id    String      @id @default(uuid())
  election_id String
  name        String
  email       String
  role        Role        @default(SISWA)
  generation  String?
  created_at  DateTime    @default(now())

  election    Election    @relation(fields: [election_id], references: [election_id], onDelete: Cascade)
  tokens      VoteToken[]
  votes       Vote[]
  email_logs  EmailLog[]

  @@unique([election_id, email])
  @@index([election_id])
  @@map("voters")
}

model VoteToken {
  token_id      String     @id @default(uuid())
  voter_id      String
  election_id   String
  token_code    String     @unique
  is_used       Boolean    @default(false)
  used_at       DateTime?
  email_sent_at DateTime?
  email_error   String?
  email_logs    EmailLog[]

  voter    Voter    @relation(fields: [voter_id], references: [voter_id], onDelete: Cascade)
  election Election @relation(fields: [election_id], references: [election_id], onDelete: Cascade)

  @@unique([voter_id, election_id])
  @@map("vote_tokens")
}

model Candidate {
  candidate_id     String   @id @default(uuid())
  election_id      String
  candidate_number Int
  name             String
  class_name       String
  photo_url        String
  vision           String   @db.Text
  mission          String   @db.Text

  election Election @relation(fields: [election_id], references: [election_id], onDelete: Cascade)
  votes    Vote[]

  @@unique([election_id, candidate_number])
  @@map("candidates")
}

model Vote {
  vote_id      String    @id @default(uuid())
  election_id  String
  voter_id     String
  candidate_id String
  voted_at     DateTime  @default(now())

  election  Election  @relation(fields: [election_id], references: [election_id], onDelete: Restrict)
  voter     Voter     @relation(fields: [voter_id], references: [voter_id], onDelete: Restrict)
  candidate Candidate @relation(fields: [candidate_id], references: [candidate_id], onDelete: Restrict)

  @@unique([voter_id, election_id])
  @@index([election_id])
  @@index([candidate_id])
  @@map("votes")
}

model EmailLog {
  log_id   String    @id @default(uuid())
  token_id String
  voter_id String
  email    String
  status   String
  error    String?
  sent_at  DateTime  @default(now())

  token VoteToken @relation(fields: [token_id], references: [token_id], onDelete: Cascade)
  voter Voter     @relation(fields: [voter_id], references: [voter_id], onDelete: Cascade)

  @@map("email_logs")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
