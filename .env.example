# ─── Database ─────────────────────────────────────────────
# Prisma Postgres pooled connection string (atau PostgreSQL lokal)
DATABASE_URL="postgres://user:password@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"

# ─── Google OAuth ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin Whitelist ─────────────────────────────────────
# Email yang diizinkan login sebagai admin (comma-separated)
ADMIN_EMAILS=

# ─── Cloudinary (Candidate Photo Upload) ──────────────────
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ─── SMTP Email Service ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smktelkom-mlg.sch.id
SMTP_RATE_PER_MINUTE=100
SMTP_DAILY_CAP=1990

# ─── School & Event Info ──────────────────────────────────
SCHOOL_NAME="SMK Telkom Malang"
VOTING_LOCATION="Gedung Serbaguna SMK Telkom Malang"
FROM_NAME="Panitia E-Pilketos"

# ─── App & Auth ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # Generate with: openssl rand -base64 32

# ─── Performance & Concurrency Tuning (Opsional) ─────────
# Kapasitas koneksi database pool paralel (default: 30)
DB_POOL_MAX=30

# Batas toleransi salah token global sebelum sistem throttle (default: 2000 per menit)
RATE_LIMIT_GLOBAL_MAX=2000

# Maksimal percobaan salah per token sebelum token terkunci (default: 5)
RATE_LIMIT_TOKEN_MAX=5

# Jendela waktu evaluasi rate limit dalam ms (default: 60000 = 1 menit)
RATE_LIMIT_WINDOW_MS=60000
