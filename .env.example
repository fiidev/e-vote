# ─── Database ─────────────────────────────────────────────
# Prisma Postgres pooled connection string
DATABASE_URL="postgres://user:password@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"

# ─── Google OAuth ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin Whitelist ─────────────────────────────────────
# Email yang diizinkan login sebagai admin (comma-separated)
ADMIN_EMAILS=

# ─── SMTP ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_RATE_PER_MINUTE=100
SMTP_DAILY_CAP=1990

# ─── School Info ──────────────────────────────────────────
SCHOOL_NAME=
VOTING_LOCATION=
FROM_NAME=

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
